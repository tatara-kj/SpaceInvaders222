<Page x:Class="SpaceIntruder.glowna"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SpaceIntruder"
      mc:Ignorable="d" 
      Background="White"
      Width="900" Height="800"
      Title="glowna">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/tlo.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Menu główne -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">

            <!-- Tytuł gry -->
            <TextBlock FontSize="64" FontWeight="Bold" Foreground="Orange" HorizontalAlignment="Center" ><Run Text="Space "/><Run Language="pl-pl" Text="rrr"/><Run Text="nvaders"/></TextBlock>

            <!-- Przycisk Nowa Gra -->
            <Button Width="200" Height="50" Foreground="White" FontSize="24" HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Black" />
                        <Setter Property="Content" Value="Nowa Gra" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <!-- Zmieniamy szablon przycisku, aby usunąć efekty tła -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Yellow"/>
                                <Setter Property="FontSize" Value="28"/>
                                <Setter Property="Content" Value="&lt;&lt; Nowa Gra &gt;&gt;" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Przycisk Instrukcje -->
            <Button Width="200" Height="50" Foreground="White" FontSize="24" HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Black" />
                        <Setter Property="Content" Value="Instrukcje" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Yellow"/>
                                <Setter Property="FontSize" Value="28"/>
                                <Setter Property="Content" Value="&lt;&lt; Instrukcje &gt;&gt;" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Przycisk Wyniki -->
            <Button Width="200" Height="50" Foreground="White" FontSize="24" HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Black" />
                        <Setter Property="Content" Value="Wyniki" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Yellow"/>
                                <Setter Property="FontSize" Value="28"/>
                                <Setter Property="Content" Value="&lt;&lt; Wyniki &gt;&gt;" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Przycisk Wyjdz -->
            <Button Width="200" Height="50" Foreground="White" FontSize="24" HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Black" />
                        <Setter Property="Content" Value="Wyjdź" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Yellow"/>
                                <Setter Property="FontSize" Value="28"/>
                                <Setter Property="Content" Value="&lt;&lt; Wyjdź &gt;&gt;" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Grid>
</Page>
