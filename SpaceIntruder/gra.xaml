<Page x:Class="SpaceIntruder.gra"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SpaceIntruder"
      mc:Ignorable="d" 
      Height="500" Width="800"
      Title="gra">
<Page.Resources>
    
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="DarkSlateBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    

</Page.Resources>
    <Grid>
        <!-- Tło GIF -->
        <Image Name="BackgroundImage" Stretch="Fill" Panel.ZIndex="0"/>

        <Canvas Name="MyCanvas" Focusable="True" Background="Transparent" KeyDown="KeyIsDown" KeyUp="KeyIsUp">
            <Label Name="Points" Foreground="White" FontSize="16" FontWeight="ExtraBold" Panel.ZIndex="20">
                Punkty: 0
            </Label>

            <Label Name="LivesAmount" Foreground="White" FontSize="16" FontWeight="ExtraBold" Panel.ZIndex="20" HorizontalAlignment="Center" Canvas.Top="31" VerticalAlignment="Top">
                Ilość żyć: 3
            </Label>

            <Label Name="CurrentBoost" Foreground="White" FontSize="16" FontWeight="ExtraBold" Panel.ZIndex="20" HorizontalAlignment="Center" Canvas.Top="62" VerticalAlignment="Top">
                
            </Label>

            <Label Name="CurrentLevel" Foreground="White" FontSize="16" FontWeight="ExtraBold" Canvas.Left="622" VerticalAlignment="Center" Panel.ZIndex="20">
                Poziom: 1
            </Label>

            <Label Name="WavesLeft" Foreground="White" FontSize="16" FontWeight="ExtraBold" Canvas.Left="622" VerticalAlignment="Top" Panel.ZIndex="20" HorizontalAlignment="Center" Canvas.Top="31">
                Pozostałe fale: 1
            </Label>

            <Image Name="Player" Width="56" Height="64" Canvas.Left="372" Canvas.Top="422" Panel.ZIndex="10"/>

        </Canvas>
 <!-- Ekran Przegranej, początkowo niewidoczny -->
 <Grid Name="LoseScreen" Background="Black" Opacity="0.7" Visibility="Collapsed">
     <!-- Tło z obrazkiem gry w tle -->
     <Image Name="GameBackground" Source="/zdjecia/player.png" Stretch="UniformToFill" Opacity="0.5" />

     <!-- Przesunięty tekst "PRZEGRANA" na ekranie -->
     <TextBlock Text="PRZEGRANA" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, -100, 0, 0"/>

     <!-- Przycisk Zagraj Ponownie -->
     <Button Content="Zagraj Ponownie" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0" Width="200" Height="50" Background="DarkSlateBlue" Foreground="White" FontWeight="Bold" FontSize="20" BorderBrush="White" BorderThickness="2" Click="PlayAgain_Click"  />

     <!-- Przycisk Wróć do Menu -->
     <Button Content="Wróć do Menu" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,150,0,0" Width="200" Height="50" Background="DarkSlateBlue" Foreground="White" FontWeight="Bold" FontSize="20" BorderBrush="White" BorderThickness="2" Click="BackToMenu_Click"  />
 </Grid>
    </Grid>
</Page>
